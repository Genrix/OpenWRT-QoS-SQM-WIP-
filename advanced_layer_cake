# /etc/config/advanced_layer_cake
# First match wins. Match Windows application DSCP before ports.
# Optionally restrict the DSCP rules to trusted clients with match_src_ip.

config class 'Games'
    option match_dscp '46'
    option set_dscp '46'

config class 'Downloads'
    option match_dscp '8'
    option set_dscp '8'

config class 'Calls'
    option match_dscp '40'
    option match_protocol 'UDP'
    option set_dscp '40'

config class 'Network'
    option match_port '53, 123'
    option set_dscp '46'

config class 'Stream'
    option match_protocol 'TCP'
    option match_port '1935'
    option set_dscp '34'

# Unmatched connections use DSCP 0 (Best Effort).
