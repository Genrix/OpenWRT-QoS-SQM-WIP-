# Advanced Layer Cake for sqm-scripts on OpenWrt 25.12.
# The SQM runner sources this file on both start and stop.

SUPPORT_MQ=1
QDISC=cake
ALC_CONFIG=advanced_layer_cake

# Six contiguous DSCP bits and a separate validity bit (including for CS0).
# Leave all other conntrack bits and the packet mark alone.
ALC_DSCP_MASK=0xfc000000
ALC_VALID=0x01000000
ALC_MASK=0xfd000000
ALC_KEEP=0x02ffffff

alc_table_name() {
    printf 'alc_'
    printf '%s' "$IFACE" | hexdump -ve '1/1 "%02x"'
}

alc_dscp() {
    local value
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    value=$(printf '%s' "$1" | sed 's/^0*//')
    value=${value:-0}
    [ "${#value}" -le 2 ] && [ "$value" -le 63 ] || return 1
    printf '%s' "$value"
}

alc_dscp_mark() {
    printf '0x%02x000000' "$(( ($1 << 2) | 1 ))"
}

# Accept only characters belonging to address or port lists. nft -c validates
# the actual addresses, prefixes, ranges and port numbers as a single batch.
alc_list() {
    local value
    value=$(printf '%s' "$1" | tr -d ' \t')
    case "$value" in
        '' ) ;;
        ,*|*,|*,,*) return 1 ;;
        *[!0-9A-Fa-f:.,/-]*) return 1 ;;
    esac
    printf '%s' "$value"
}

alc_addr_family() {
    case "$1" in
        *:*) printf 'ip6' ;;
        ?*) printf 'ip' ;;
    esac
}

alc_rule_error() {
    sqm_error "Advanced Layer Cake: class '$1': invalid $2"
    return 1
}

alc_class() {
    local section="$1" dscp match_dscp src dst protocols ports
    local src_family dst_family family match mark protocol transport l4

    config_get dscp "$section" set_dscp
    config_get match_dscp "$section" match_dscp
    config_get src "$section" match_src_ip
    config_get dst "$section" match_dst_ip
    config_get protocols "$section" match_protocol
    config_get ports "$section" match_port

    dscp=$(alc_dscp "$dscp") || { alc_rule_error "$section" set_dscp; return 1; }
    if [ -n "$match_dscp" ]; then
        match_dscp=$(alc_dscp "$match_dscp") ||
            { alc_rule_error "$section" match_dscp; return 1; }
    fi
    src=$(alc_list "$src") || { alc_rule_error "$section" match_src_ip; return 1; }
    dst=$(alc_list "$dst") || { alc_rule_error "$section" match_dst_ip; return 1; }
    src_family=$(alc_addr_family "$src")
    dst_family=$(alc_addr_family "$dst")
    if [ -n "$src_family" ] && [ -n "$dst_family" ] && [ "$src_family" != "$dst_family" ]; then
        alc_rule_error "$section" 'combination of source and destination families'
        return 1
    fi

    ports=$(alc_list "$ports") || { alc_rule_error "$section" match_port; return 1; }
    case "$ports" in
        *[!0-9,-]*) alc_rule_error "$section" match_port; return 1 ;;
    esac
    protocols=$(printf '%s' "$protocols" | tr -d ' \t' | tr 'A-Z' 'a-z')
    case "$protocols" in
        ,*|*,|*,,*|*[!a-z0-9,]*) alc_rule_error "$section" match_protocol; return 1 ;;
    esac
    transport=$(printf '%s' "${protocols:-${ports:+tcp,udp}}" | tr ',' ' ')
    for protocol in $transport; do
        case "$protocol:${src_family:-$dst_family}" in
            tcp:*|udp:*|icmp:|icmp:ip|icmpv6:|icmpv6:ip6) ;;
            *) alc_rule_error "$section" match_protocol; return 1 ;;
        esac
    done
    if [ "$ALC_CATCHALL" = 1 ]; then
        sqm_error "Advanced Layer Cake: class '$section' follows a catch-all"
        return 1
    fi
    if [ -z "$match_dscp$src$dst$protocols$ports" ]; then
        ALC_CATCHALL=1
    fi

    mark=$(alc_dscp_mark "$dscp")
    for family in ${src_family:-${dst_family:-ip ip6}}; do
        match="meta nfproto ipv4"
        [ "$family" = ip6 ] && match="meta nfproto ipv6"
        [ -z "$src" ] || match="$match $family saddr { $src }"
        [ -z "$dst" ] || match="$match $family daddr { $dst }"
        [ -z "$match_dscp" ] || match="$match $family dscp $match_dscp"

        # ICMP has no ports. In a mixed protocol rule, the port condition
        # applies only to the TCP/UDP branches, as in the original config.
        if [ -z "$transport" ]; then
            printf '  %s counter ct mark set ct mark & %s | %s return comment "%s"\n' \
                "$match" "$ALC_KEEP" "$mark" "$section"
            continue
        fi
        for protocol in $transport; do
            case "$protocol" in
                tcp|udp)
                    l4="meta l4proto $protocol"
                    [ -z "$ports" ] || l4="$l4 th dport { $ports }"
                    ;;
                icmp)
                    [ "$family" = ip ] || continue
                    l4='meta l4proto icmp'
                    ;;
                icmpv6)
                    [ "$family" = ip6 ] || continue
                    l4='meta l4proto ipv6-icmp'
                    ;;
            esac
            printf '  %s %s counter ct mark set ct mark & %s | %s return comment "%s"\n' \
                "$match" "$l4" "$ALC_KEEP" "$mark" "$section"
        done
    done
}

alc_compile() (
    local sections section dscp
    . /lib/functions.sh
    if ! uci export "$ALC_CONFIG" >/dev/null || ! config_load "$ALC_CONFIG"; then
        sqm_error "Advanced Layer Cake: cannot read /etc/config/$ALC_CONFIG"
        return 1
    fi

    sections=$(config_foreach echo class)
    [ -n "$sections" ] || return 2
    # Destroy + recreate in one nft transaction. An absent table is fine.
    printf 'destroy table inet %s\ntable inet %s {\n' "$ALC_TABLE" "$ALC_TABLE"
    printf ' chain classify {\n'
    ALC_CATCHALL=0
    for section in $sections; do
        # UCI identifiers are safe to include in nft comments.
        case "$section" in *[!a-zA-Z0-9_]*) return 1 ;; esac
        alc_class "$section" || return 1
    done
    if [ "$ALC_CATCHALL" = 0 ]; then
        printf '  counter ct mark set ct mark & %s | %s return comment "Default CS0"\n' "$ALC_KEEP" "$ALC_VALID"
    fi
    printf ' }\n map restore {\n  type mark : verdict\n  elements = {\n'
    # A verdict map lets nft set the six-bit DSCP field with a constant.
    # Keep all values so open connections retain their class across reloads.
    for dscp in $(seq 0 63); do
        printf '   %s : goto dscp_%s,\n' "$(alc_dscp_mark "$dscp")" "$dscp"
    done
    printf '  }\n }\n'
    for dscp in $(seq 0 63); do
        printf ' chain dscp_%s {\n  ip dscp set %s return\n  ip6 dscp set %s\n }\n' "$dscp" "$dscp" "$dscp"
    done
    printf ' chain egress_classify {\n  type filter hook postrouting priority mangle + 1; policy accept;\n'
    printf '  oifname != "%s" return\n' "$IFACE"
    printf '  ct mark & %s vmap @restore\n' "$ALC_MASK"
    printf '  ct state { invalid, untracked } return\n'
    printf '  jump classify\n'
    printf '  ct mark & %s vmap @restore\n }\n}\n' "$ALC_MASK"
)

alc_apply_cake() {
    local device="$1" rate="$2" qdisc
    shift 2
    qdisc=$(select_cake "$device") || return 1
    $TC qdisc replace dev "$device" root $(get_stab_string) "$qdisc" \
        bandwidth "${rate}kbit" $(get_cake_lla_string) "$@"
}

alc_start_ingress() {
    local cake_opts="$INGRESS_CAKE_OPTS"
    [ "$ALC_ACTIVE" = 0 ] || cake_opts="$cake_opts diffserv4 ingress"
    [ "$IGNORE_DSCP_INGRESS" != 1 ] || cake_opts="$cake_opts besteffort"
    [ "$ZERO_DSCP_INGRESS" != 1 ] || cake_opts="$cake_opts wash"

    DEV=$(ifb_name "$IFACE") || return 1
    create_ifb "$DEV" || return 1
    ALC_IFB_CREATED=1
    alc_apply_cake "$DEV" "$DOWNLINK" $cake_opts $IQDISC_OPTS || return 1
    $IP link set dev "$DEV" up || return 1
    $TC qdisc add dev "$IFACE" handle ffff: ingress || return 1
    ALC_INGRESS_CREATED=1
    if [ "$ALC_ACTIVE" = 1 ]; then
        set -- action ctinfo dscp "$ALC_DSCP_MASK" "$ALC_VALID" pipe
    else
        set --
    fi
    $TC filter add dev "$IFACE" parent ffff: protocol all prio 10 u32 match u32 0 0 \
        "$@" action mirred egress redirect dev "$DEV"
}

alc_start_exit() {
    local status="$1"
    if [ "$status" -ne 0 ]; then
        [ "$ALC_TABLE_INSTALLED" = 0 ] || nft destroy table inet "$ALC_TABLE"
        [ "$ALC_INGRESS_CREATED" = 0 ] || $TC qdisc del dev "$IFACE" ingress
        [ "$ALC_IFB_CREATED" = 0 ] || delete_ifb "$DEV"
        sqm_error "Advanced Layer Cake: could not start on $IFACE"
    fi
    rm -f "$ALC_RULES"
}

sqm_start() (
    local result cake_opts error
    ALC_ACTIVE=0
    ALC_TABLE_INSTALLED=0
    ALC_IFB_CREATED=0
    ALC_INGRESS_CREATED=0
    [ "$UPLINK" -ne 0 ] || [ "$DOWNLINK" -ne 0 ] || return 0
    case "$IFACE" in
        ''|*[!a-zA-Z0-9_.:-]*) sqm_error "Advanced Layer Cake: invalid interface '$IFACE'"; return 1 ;;
    esac
    ALC_TABLE=$(alc_table_name) || return 1
    ALC_RULES=$(mktemp) || return 1
    trap 'alc_start_exit "$?"' EXIT
    alc_compile > "$ALC_RULES"
    result=$?
    case "$result" in
        0)
            if [ "$(uci -q get 'firewall.@defaults[0].flow_offloading')" = 1 ] ||
               [ "$(uci -q get 'firewall.@defaults[0].flow_offloading_hw')" = 1 ]; then
                sqm_error 'Advanced Layer Cake: turn off firewall flow offloading to use classification'
                return 1
            fi
            error=$(nft -c -f "$ALC_RULES" 2>&1) || {
                sqm_error "Advanced Layer Cake: invalid nft rules: $error"
                return 1
            }
            ALC_ACTIVE=1
            ;;
        2) ;;
        *) return 1 ;;
    esac

    do_modules
    verify_qdisc cake || return 1
    if [ "$DOWNLINK" -ne 0 ]; then
        alc_start_ingress || return 1
    fi
    if [ "$ALC_ACTIVE" = 1 ]; then
        nft -f "$ALC_RULES" || return 1
        ALC_TABLE_INSTALLED=1
    fi
    if [ "$UPLINK" -ne 0 ]; then
        cake_opts="$EGRESS_CAKE_OPTS"
        [ "$ALC_ACTIVE" = 0 ] || cake_opts="$cake_opts diffserv4"
        alc_apply_cake "$IFACE" "$UPLINK" $cake_opts $EQDISC_OPTS || return 1
    fi
    return 0
)

alc_remove() {
    local table
    table=$(alc_table_name) || return 1
    if command -v nft >/dev/null; then
        nft destroy table inet "$table" ||
            sqm_error "Advanced Layer Cake: could not remove nft table $table"
    fi
    if [ "$DOWNLINK" -ne 0 ] && [ -n "$CUR_IFB" ] &&
       SILENT=1 $IP link show dev "$CUR_IFB" >/dev/null; then
        SILENT=${1:-0} $IP link delete dev "$CUR_IFB" type ifb
    fi
}

# SQM 1.7.2's OpenWrt runner does not pass rates to stop-sqm. Read the
# recorded rates so stopping a one-way instance only removes its own queues.
sqm_stop() (
    . "$STATE_FILE" || return 1
    [ "$DOWNLINK" -eq 0 ] || SILENT=1 $TC qdisc del dev "$IFACE" ingress
    [ "$UPLINK" -eq 0 ] || SILENT=1 $TC qdisc del dev "$IFACE" root
    alc_remove
)

sqm_cleanup() (
    . "$STATE_FILE" || return 1
    alc_remove "${1:-0}"
)
